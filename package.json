{
  "name": "grusiber-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply grusiber --local",
    "db:seed:local": "wrangler d1 execute grusiber --local --file scripts/seed-local.sql",
    "db:migrate": "wrangler d1 migrations apply grusiber --remote",
    "db:go:migrate:local": "wrangler d1 migrations apply grusiber-go-db --local"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  }
}
